{
  "name": "@aemeath/dsh-plugin-workflow",
  "version": "0.1.0",
  "description": "Aemeath physicist 解题工作流：分流、SymPy 验证/量纲检查、plan 落 scratch、Action Gate、爱弥斯零回归（M6 v2）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./route": {
      "types": "./lib/route.d.ts",
      "default": "./lib/route.js"
    },
    "./plan": {
      "types": "./lib/plan.d.ts",
      "default": "./lib/plan.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/route.js",
    "lib/plan.js",
    "lib/*.d.ts",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/check.mjs && node test/check2.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
