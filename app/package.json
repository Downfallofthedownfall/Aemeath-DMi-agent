{
  "name": "aemeath-desktop-v2",
  "version": "2.0.0-m0",
  "description": "Aemeath-DMi Agent v2 — Electron 桌宠壳（M5）：托管 dsh 服务 + 本地 3081 品牌窗口",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.1.1-rc.1",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aemeath.desktop-v2",
    "productName": "爱弥斯 · 物理学习 Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts"
      },
      {
        "from": "../profiles",
        "to": "profiles"
      },
      {
        "from": "../packages",
        "to": "packages"
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../package-lock.json",
        "to": "package-lock.json"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../tsconfig.base.json",
        "to": "tsconfig.base.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "爱弥斯 · 物理学习 Copilot",
      "runAfterFinish": true
    }
  }
}
